{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__PY__ \"__AGENT_KIT__/hooks/command-guard.py\" --decision deny",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "__PY__ \"__AGENT_KIT__/hooks/kit-check.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
